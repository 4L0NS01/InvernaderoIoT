<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Invernadero Inteligente"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conexión Inalámbrica MQTT Activa"
            android:textSize="13sp"
            android:textColor="#546E7A"
            android:layout_marginBottom="16dp"/>

        <!-- Tarjeta de Monitoreo de Humedad -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💧 TELEMETRÍA: HUMEDAD DE SUELO"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0288D1"/>

                <TextView
                    android:id="@+id/textoHumedad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Humedad: Esperando señal..."
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de Estado del Actuador / Bomba -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ ACTUADOR: BOMBA DE AGUA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#E65100"/>

                <TextView
                    android:id="@+id/textoEstadoBomba"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado Bomba: APAGADA"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#37474F"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de Simulación de Sensor (Interconexión Móvil) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📡 TRANSMISOR / EMULADOR DE HUMEDAD"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#558B2F"/>

                <TextView
                    android:id="@+id/lblValorBarra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Desliza para transmitir valor: 0"
                    android:textSize="14sp"
                    android:textColor="#37474F"
                    android:layout_marginTop="6dp"/>

                <SeekBar
                    android:id="@+id/barraHumedad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="4095"
                    android:progress="0" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botones de Control Remoto -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonEncender"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ENCENDER BOMBA"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonApagar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="APAGAR BOMBA"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:backgroundTint="#C62828"
            android:layout_marginBottom="16dp"/>

        <!-- Consulta de Base de Datos SQLite -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonConsultarBD"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="CONSULTAR HISTORIAL SQLITE"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            android:backgroundTint="#455A64"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

        <TextView
            android:id="@+id/textoHistorialBD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Último registro en BD: Sin consultas aún"
            android:textSize="12sp"
            android:textColor="#78909C"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>